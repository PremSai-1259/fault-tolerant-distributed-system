{
  "title": "Fault Tolerance",
  "panels": [
    {
      "title": "Failures Detected",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(failure_detector_failures_detected_total)",
          "legendFormat": "Failures detected"
        }
      ]
    },
    {
      "title": "Recoveries Recorded",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(failure_detector_recoveries_total)",
          "legendFormat": "Recoveries"
        }
      ]
    },
    {
      "title": "HTTP 5xx Errors",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (exported_service, status) (rate(ft_http_requests_total{status=~\"5..\"}[1m]))",
          "legendFormat": "{{exported_service}} - {{status}}"
        }
      ]
    },
    {
      "title": "HTTP Request Rate",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (exported_service) (rate(ft_http_requests_total[1m]))",
          "legendFormat": "{{exported_service}}"
        }
      ]
    }
  ],
  "schemaVersion": 39
}

